#!/bin/sh
# Herdr event hook: copies the title Claude Code or Codex gives its session
# into the label of the herdr tab the pane lives in, and into a
# $session_title token on its workspace for the sidebar. Claude's title comes
# from its terminal title; Codex's thread name from Codex's session index.
# herdr-plugin.toml runs this on pane.agent_status_changed, pane.focused and
# tab.closed. The decisions live in
# lib/decide.sh; this file only gathers inputs from herdr and applies them.
#
# Runs on every matching event, so it always exits 0: a failure here must
# never surface as a broken hook in herdr.

set -u

root=$(dirname "$0")/..
# shellcheck source=lib/decide.sh
. "$root/lib/decide.sh"

herdr=${HERDR_BIN_PATH:-herdr}
pane_id=${HERDR_PANE_ID:-}
state_dir=${HERDR_PLUGIN_STATE_DIR:-}
# Workspace metadata key; namespaced because keys are shared by all reporters.
token=session_title

# json_field JSON FILTER: print one jq field, or empty when missing.
json_field() {
	printf '%s' "$1" | jq -r "$2 // \"\""
}

# state_file TAB_ID: where the last label the plugin gave a tab is kept.
# Tab ids look like "w1:t1"; keep the file name free of separators.
state_file() {
	printf '%s/%s' "$state_dir" "$(printf '%s' "$1" | tr -c 'A-Za-z0-9_-' '_')"
}

# codex_thread_name SESSION_ID: the model-generated name of a Codex thread,
# from the session index Codex appends to whenever a thread is (re)named.
# The last matching line wins. Prints nothing when the thread has no name yet.
codex_thread_name() {
	[ -n "$1" ] || return 0
	index="${CODEX_HOME:-$HOME/.codex}/session_index.jsonl"
	grep -F "\"id\":\"$1\"" "$index" 2>/dev/null | tail -n 1 |
		jq -r '.thread_name // ""' 2>/dev/null
}

# shown_pane WORKSPACE_ID: the pane a workspace shows, the focused pane of its
# active tab. Used for tab.closed, which names a workspace but no pane.
shown_pane() {
	[ -n "$1" ] || return 0
	ws=$("$herdr" workspace get "$1" 2>/dev/null) || return 0
	active=$(json_field "$ws" '.result.workspace.active_tab_id')
	panes=$("$herdr" pane list --workspace "$1" 2>/dev/null) || return 0
	any=$(printf '%s' "$panes" |
		jq -r --arg t "$active" '[.result.panes[] | select(.tab_id == $t)][0].pane_id // ""')
	[ -n "$any" ] || return 0
	layout=$("$herdr" pane layout --pane "$any" 2>/dev/null) || return 0
	json_field "$layout" '.result.layout.focused_pane_id'
}

# acquire_lock: serialise hook runs. herdr runs hooks concurrently, and two
# interleaved runs could save a label that isn't the one shown, which would
# then look like a manual rename forever. Waits about 5 s, takes over a lock
# older than a minute (a crashed run), and releases the lock on exit.
acquire_lock() {
	lock="$state_dir/.lock"
	tries=0
	until mkdir "$lock" 2>/dev/null; do
		tries=$((tries + 1))
		[ "$tries" -le 50 ] || return 1
		if [ -n "$(find "$lock" -prune -mmin +1 2>/dev/null)" ]; then
			rmdir "$lock" 2>/dev/null
			continue
		fi
		sleep 0.1
	done
	trap 'rmdir "$lock" 2>/dev/null' EXIT
	trap 'exit 0' HUP INT TERM
}

# sync_tab: name the pane's tab after its title.
sync_tab() {
	# Cheap early exit: only panes with a session title can name a tab.
	usable_title "$agent" "$title" || return 0
	tab=$("$herdr" tab get "$tab_id" 2>/dev/null) || return 0
	tab_label=$(json_field "$tab" '.result.tab.label')
	state=$(state_file "$tab_id")
	last_set=$(cat "$state" 2>/dev/null || true)

	new_label=$(decide_label "$agent" "$title" "$pane_id" "$focused_pane_id" \
		"$tab_label" "$last_set")
	[ -n "$new_label" ] || return 0
	renamed=$("$herdr" tab rename "$tab_id" "$new_label" 2>/dev/null) || return 0
	# Remember the label herdr stored, so the manual-rename check compares
	# like with like.
	stored=$(json_field "$renamed" '.result.tab.label')
	printf '%s' "${stored:-$new_label}" >"$state" 2>/dev/null
}

# sync_workspace: set or clear the workspace's title token from the pane the
# workspace shows: the focused pane of its active tab.
sync_workspace() {
	workspace=$("$herdr" workspace get "$workspace_id" 2>/dev/null) || return 0
	active_tab_id=$(json_field "$workspace" '.result.workspace.active_tab_id')
	current=$(json_field "$workspace" ".result.workspace.tokens.$token")
	naming_pane=""
	[ "$active_tab_id" = "$tab_id" ] && naming_pane=$focused_pane_id

	action=$(decide_workspace_token "$agent" "$title" "$pane_id" "$naming_pane")
	case $action in
	set:*)
		[ "$current" != "${action#set:}" ] || return 0
		"$herdr" workspace report-metadata "$workspace_id" --source herdr-tab-titles \
			--token "$token=${action#set:}" >/dev/null 2>&1
		;;
	clear)
		[ -n "$current" ] || return 0
		"$herdr" workspace report-metadata "$workspace_id" --source herdr-tab-titles \
			--clear-token "$token" >/dev/null 2>&1
		;;
	esac
}

[ -n "$state_dir" ] || exit 0
acquire_lock || exit 0

# Closing a tab changes what its workspace shows, but herdr only sends focus
# events for the workspace on screen, so resolve the shown pane ourselves.
[ -n "$pane_id" ] || pane_id=$(shown_pane "${HERDR_WORKSPACE_ID:-}")
[ -n "$pane_id" ] || exit 0

# Read the pane inside the lock so the last run applies the newest state.
pane=$("$herdr" pane get "$pane_id" 2>/dev/null) || exit 0
agent=$(json_field "$pane" '.result.pane.agent')
case $agent in
claude) title=$(json_field "$pane" '.result.pane.terminal_title_stripped') ;;
codex) title=$(codex_thread_name "$(json_field "$pane" '.result.pane.agent_session.value')") ;;
*) title="" ;;
esac
# Titles come from the terminal or agent files and are untrusted; drop
# control characters.
title=$(printf '%s' "$title" | tr -d '[:cntrl:]')
tab_id=$(json_field "$pane" '.result.pane.tab_id')
workspace_id=$(json_field "$pane" '.result.pane.workspace_id')
[ -n "$tab_id" ] && [ -n "$workspace_id" ] || exit 0

layout=$("$herdr" pane layout --pane "$pane_id" 2>/dev/null) || exit 0
focused_pane_id=$(json_field "$layout" '.result.layout.focused_pane_id')

sync_tab
sync_workspace
exit 0
